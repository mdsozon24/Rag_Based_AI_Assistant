GEMINI_API_KEY=
NODE_ENV=development
PORT=3100

# Admin accounts (comma-separated emails). Only admins can view uploaded documents.
ADMIN_EMAILS=
# Password for the first ADMIN_EMAILS address; the account is created or reset to it on every start
ADMIN_PASSWORD=

# Optional ElevenLabs TTS for a more natural Bangla voice (falls back to Gemini TTS when unset)
ELEVENLABS_API_KEY=
# Default voice; admins can pick another voice in the app (Voice button)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3_conversational
# 0 = most expressive, 0.5 = natural, 1 = flattest
ELEVENLABS_STABILITY=0.5
# 0 = neutral delivery; higher values exaggerate the voice's own style (optional)
ELEVENLABS_STYLE=
ELEVENLABS_SPEED=1.0

# Optional password-reset email configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_URL=http://localhost:3100
# ---- Voice engine (packages/engine): cascaded STT -> LLM -> TTS pipeline ----
# Providers are chosen per assistant (preset "fast" | "balanced" | "quality", or explicit
# transcriber/model/voice config). The keys below are PLATFORM keys: used, and billed to the
# platform, when an org has not stored its own key. GEMINI_API_KEY and ELEVENLABS_API_KEY above
# serve the default "balanced" preset. Providers without a key are skipped as fallbacks.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
# Default Cartesia voice id when an assistant sets none (needed by the "fast" preset)
CARTESIA_VOICE_ID=

# Encryption for org-stored provider keys (bring your own key): 32 random bytes, base64.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it, org keys cannot be stored; platform keys still work.
CREDENTIALS_ENCRYPTION_KEY=
# Id stored with each record, so keys can be rotated
CREDENTIALS_KEY_ID=k1
# Old keys kept only to decrypt existing records after rotation: "id:base64,id:base64"
CREDENTIALS_PREVIOUS_KEYS=

# Allow "custom" provider endpoints on private networks and without TLS. Development only;
# refused when NODE_ENV=production.
CUSTOM_ENDPOINTS_ALLOW_PRIVATE=false

# Local dev server (npm run voice:dev); listens on 127.0.0.1 only
VOICE_DEV_PORT=3200
# Log level for engine JSON logs: debug | info | warn | error
LOG_LEVEL=info

# ---- API (apps/api): users, orgs, roles, API keys ----
# postgres://user:pass@host/db in production; pglite://./.data/api-db = local Postgres-in-process
# (one process at a time); pglite://memory = tests
DATABASE_URL=pglite://./.data/api-db
API_HOST=127.0.0.1
API_PORT=3300
MAX_CONCURRENT_CALLS_PER_ORG=10
# Browser calls (GET /v1/calls/{id}/connect) this API process runs at once; more are refused (4503)
VOICE_MAX_SESSIONS=50
# How long a browser call survives a dropped connection while the SDK reconnects (ms, 0 = end at once)
VOICE_RESUME_GRACE_MS=15000
# Twilio signs webhooks with the account auth token; used for voice and SMS webhooks
TWILIO_WEBHOOK_SECRET=
# SMS replies (optional channel): Twilio account used to send them. A number answers SMS only when
# its capabilities include "sms" (PATCH /v1/phone-numbers/{id}). TWILIO_API_URL is for test doubles.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_URL=
# Chat sessions (POST /v1/chat, /v1/chat/completions, SMS): idle expiry, how many recent messages
# go to the model each turn, and when a session ends ("max-messages")
CHAT_SESSION_IDLE_MINUTES=1440
CHAT_MAX_HISTORY_MESSAGES=40
CHAT_MAX_MESSAGES_PER_SESSION=400
# SMS replies are split at sentence boundaries: segments per message (1 = 160 GSM-7 / 70 Unicode
# characters, e.g. Bangla) and messages per reply (the rest is cut with "...")
SMS_MAX_SEGMENTS_PER_MESSAGE=3
SMS_MAX_MESSAGES_PER_REPLY=5
# Outbound campaigns. The dialer runs inside the API process (true) and ticks every N seconds.
# Provider call-progress callbacks (POST /v1/telephony/{provider}/status/{attemptId}) are verified
# with TWILIO_WEBHOOK_SECRET above, so campaigns on Twilio need it and API_PUBLIC_URL (below) to be
# reachable by Twilio. The org limit MAX_CONCURRENT_CALLS_PER_ORG caps every campaign.
CAMPAIGN_DIALER_ENABLED=true
CAMPAIGN_TICK_SECONDS=5
# Platform calling hours in the CONTACT's local time (HH:MM). No campaign can start a call outside
# them, whatever its own schedule says. Check the rules for the countries you call before widening.
CAMPAIGN_HARD_CAP_START=08:00
CAMPAIGN_HARD_CAP_END=21:00
# A provider dial request slower than this counts as unconfirmed (not retried: the call may exist)
CAMPAIGN_DIAL_TIMEOUT_SECONDS=25
# A dial with no provider report after this long is closed as unconfirmed (seconds)
CAMPAIGN_DIAL_CONFIRM_SECONDS=120
# A ringing or connected call with no final provider event after this long is closed as lost (minutes)
CAMPAIGN_CALL_TIMEOUT_MINUTES=120
# Contacts per campaign, and rows per CSV upload
CAMPAIGN_MAX_CONTACTS=50000
CAMPAIGN_MAX_UPLOAD_ROWS=10000
# Post-call analysis (summary, success evaluation, structured outputs). Runs inside the API process (true).
# It uses each call's own model (the org's key, else the platform key), so every assistant that enables
# analysis needs a working model key. Jobs are retried with backoff up to ANALYSIS_MAX_ATTEMPTS.
ANALYSIS_ENABLED=true
ANALYSIS_TICK_SECONDS=5
# Jobs per org per tick
ANALYSIS_CONCURRENCY=3
ANALYSIS_MAX_ATTEMPTS=4
# First retry delay (then x4 each time, at most an hour)
ANALYSIS_RETRY_BASE_SECONDS=30
# A job whose worker disappears is taken over after this long
ANALYSIS_LEASE_SECONDS=300
# Longest transcript sent to the model; a longer call keeps its start and end
ANALYSIS_MAX_TRANSCRIPT_CHARS=60000
# Sends queued call webhooks (end-of-call-report) automatically: signed, https only, private addresses
# refused, 8 attempts over about 11 hours. Chat events stay on manual redelivery.
WEBHOOK_DELIVERY_ENABLED=true
WEBHOOK_DELIVERY_TICK_SECONDS=5
# Observability. Monitoring policies (alert rules) are evaluated by a worker inside the API process (true),
# which also sends alert emails/webhooks and deletes expired debug data.
MONITORING_ENABLED=true
MONITORING_TICK_SECONDS=60
# Longest date range a board or scorecard query may cover
BOARD_MAX_RANGE_DAYS=92
# Days the full LLM prompts and replies of calls with debug.captureLlm are kept
DEBUG_RETENTION_DAYS=14
# Log lines and partial transcripts kept per call in the debug timeline (the rest is counted, not stored)
DEBUG_LOG_LINES_PER_CALL=500
DEBUG_PARTIALS_PER_CALL=300
# Bearer token Prometheus presents to GET /metrics (at least 24 characters). Empty: /metrics answers 404.
METRICS_TOKEN=
# Error tracking: errors go to Sentry only when a DSN is set (scrubbed: no bodies, headers or user data)
SENTRY_DSN=
# Defaults to NODE_ENV
SENTRY_ENVIRONMENT=
# Shown in logs, GET /ready, metrics and Sentry; defaults to the package version
APP_VERSION=
# Reserved for an operator admin page (comma-separated emails); not used yet
OPERATOR_EMAILS=
# Public base URL of the API as clients see it (https://api.example.com behind a proxy). Call
# WebSocket URLs (wss://.../v1/calls/{id}/connect) are built from it. Defaults to http://API_HOST:API_PORT;
# required in production
API_PUBLIC_URL=
# Dashboard base URL (links in emails) and the origins allowed to use the session cookie (CSRF)
DASHBOARD_URL=http://localhost:3000
DASHBOARD_ORIGINS=http://localhost:3000
SESSION_TTL_DAYS=30
# Sign out after this many days without activity
SESSION_IDLE_DAYS=7
# Defaults to true when NODE_ENV=production
COOKIE_SECURE=
# Which proxies may report the client address (X-Forwarded-For) for rate limits and the audit log:
# false (none), true (any hop: only when every request passes an ingress that OVERWRITES the header),
# or the proxies' own IPs/CIDRs, comma-separated (recommended), e.g. 10.0.0.0/8. The dashboard's /v1
# proxy passes a client-sent X-Forwarded-For through unchanged, so put an ingress in front of the
# dashboard that overwrites or appends the header, and list the ingress and dashboard addresses here.
TRUST_PROXY=false
# Requests per minute; can be overridden per API key and per org
RATE_LIMIT_KEY_PER_MINUTE=600
RATE_LIMIT_ORG_PER_MINUTE=1200
# Sign-in / sign-up / password-reset attempts per IP (and per email) per 15 minutes
AUTH_RATE_LIMIT_PER_15_MIN=10
# Optional "Sign in with Google"
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3300/v1/auth/google/callback
# Email for the API uses SMTP_* above; without SMTP_HOST, emails are logged (dev only; required in production).
# SMTP port 465 uses implicit TLS; other ports must support STARTTLS.
