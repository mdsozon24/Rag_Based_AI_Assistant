{
  "name": "@octo/dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Voice of Octo customer dashboard (Next.js). Talks only to the public /v1 API.",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
