{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "lint": "tsc -p tsconfig.strict.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "voice:dev": "tsx packages/engine/dev/voice-dev.ts",
    "voice:smoke": "tsx packages/engine/dev/smoke.ts",
    "api:dev": "tsx apps/api/src/server.ts",
    "api:migrate": "tsx apps/api/src/db/migrateCli.ts",
    "dashboard:dev": "npm --prefix apps/dashboard run dev",
    "dashboard:build": "npm --prefix apps/dashboard run build",
    "dashboard:test": "npm --prefix apps/dashboard run test",
    "sdk:build": "npm --prefix packages/sdk run build",
    "test:e2e": "npm run sdk:build && playwright test -c packages/sdk/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cookie": "^11.1.2",
    "@fastify/websocket": "^11.3.1",
    "@google/genai": "^2.4.0",
    "@node-rs/argon2": "^2.2.1",
    "@sentry/node": "^11.2.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fastify": "^5.12.5",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "vite": "^6.2.3",
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "openai": "^5.23.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.3"
  }
}
